---
import type { ExperienceItem } from "../data/profile";
export interface Props {
  items: ExperienceItem[];
  title?: string;
  variant?: 'light' | 'dark';
  earlierLabel?: string;
}
const FEATURED_COUNT = 3;
const { items, title = 'Experience', variant = 'light', earlierLabel = 'Earlier' } = Astro.props as Props;
const isDark = variant === 'dark';
---
<section id="experience" class:list={[isDark ? 'mt-0' : 'mt-20 md:mt-28']}>
  <h2 class:list={['heading-section font-display', isDark ? 'text-white' : 'text-black dark:text-white']}>
    {title}
  </h2>
  <div class="mt-8 space-y-8">
    {items.map((job, i) => {
      const featured = i < FEATURED_COUNT;
      const showEarlierLabel = i === FEATURED_COUNT;
      return (
        <>
          {showEarlierLabel && (
            <p
              class:list={[
                'section-label pt-2',
                isDark ? 'text-white/45' : 'text-black/45 dark:text-white/45',
              ]}
            >
              {earlierLabel}
            </p>
          )}
          <article
            class:list={[
              isDark ? 'card-research' : 'card',
              featured
                ? isDark ? 'card-research-featured' : 'card-featured'
                : isDark ? 'card-research-muted' : 'card-muted',
            ]}
          >
            <header>
              <h3
                class:list={[
                  'font-medium leading-tight font-display',
                  featured ? 'text-[1.75rem]' : 'text-[1.25rem]',
                  isDark ? 'text-white' : 'text-black dark:text-white',
                ]}
                style={featured ? 'letter-spacing: -0.42px;' : 'letter-spacing: -0.22px;'}
              >
                {job.title}
              </h3>
              {job.period && (
                <p
                  class:list={[
                    'mt-0.5 leading-snug font-normal',
                    featured ? 'text-sm' : 'text-xs',
                    isDark ? 'text-white/45' : 'text-black/45 dark:text-white/45',
                  ]}
                >
                  {job.period}
                </p>
              )}
              <p
                class:list={[
                  'mt-1 caption',
                  isDark ? 'text-white/60' : 'text-black/60 dark:text-white/60',
                ]}
              >
                {job.company}
              </p>
              {job.progression && (
                <p
                  class:list={[
                    'mt-1 caption',
                    isDark ? 'text-white/60' : 'text-black/60 dark:text-white/60',
                  ]}
                >
                  {job.progression}
                </p>
              )}
            </header>
            <ul
              class:list={[
                'mt-4 list-disc space-y-2 pl-5 leading-relaxed',
                featured ? 'text-sm' : 'text-[0.8125rem]',
                isDark ? 'text-white/90' : 'text-black/90 dark:text-white/90',
              ]}
              style="letter-spacing: -0.16px;"
            >
              {job.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        </>
      );
    })}
  </div>
</section>
